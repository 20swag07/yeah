{
  "expo": {
    "name": "Dash Cam",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.carguardvision.sesf86",
      "infoPlist": {
        "NSCameraUsageDescription": "Record the road ahead while you drive",
        "NSMicrophoneUsageDescription": "Capture audio with your dash cam footage",
        "NSLocationWhenInUseUsageDescription": "Show your live speed and stamp it on clips",
        "NSMotionUsageDescription": "Detect impacts and save the clip automatically",
        "NSPhotoLibraryAddUsageDescription": "Download dash cam clips to your Photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.carguardvision.sesf86",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Record the road ahead while you drive",
          "microphonePermission": "Capture audio with your dash cam footage",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show your live speed and stamp it on clips"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Detect impacts and save the clip automatically"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF3B30"
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Download dash cam clips to your Photos",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}